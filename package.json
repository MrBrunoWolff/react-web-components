{
  "name": "@mrbrunowolff/react-web-components-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for self-contained React components wrapped as Web Components",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "bun install && cd packages/react-web-components && bun install && cd ../showcase-react && bun install && cd ../showcase-wc && bun install && cd ../..",
    "dev": "bun run --filter='*' dev",
    "build": "bun run --filter='*' build",
    "build:lib": "bun run --filter=@mrbrunowolff/react-web-components build:lib",
    "showcase:react": "bun run --filter=showcase-react dev",
    "showcase:wc": "bun run --filter=showcase-wc dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "test": "bun run --filter='*' test",
    "clean": "bun run --filter='*' clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun",
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "monorepo",
    "react",
    "web-components",
    "shadcn",
    "ui",
    "components",
    "design-system",
    "bun",
    "flexlayout",
    "self-contained"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MrBrunoWolff/react-web-components.git"
  },
  "author": "Bruno Wolff",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MrBrunoWolff/react-web-components/issues"
  },
  "homepage": "https://github.com/MrBrunoWolff/react-web-components#readme"
}
