{
  "name": "@mrbrunowolff/react-web-components",
  "version": "1.0.0",
  "description": "Self-contained shadcn/ui components wrapped as Web Components for use in any framework - no external CSS dependencies required",
  "keywords": [
    "bun",
    "components",
    "design-system",
    "flexlayout",
    "react",
    "self-contained",
    "shadcn",
    "ui",
    "web-components"
  ],
  "homepage": "https://github.com/MrBrunoWolff/react-web-components#readme",
  "bugs": {
    "url": "https://github.com/MrBrunoWolff/react-web-components/issues"
  },
  "license": "MIT",
  "author": "Bruno Wolff",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrBrunoWolff/react-web-components.git"
  },
  "files": [
    "dist/web-components",
    "dist/components",
    "dist/lib",
    "dist/index.d.ts",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": {
      "types": "./src/*",
      "import": "./src/*",
      "require": "./src/*",
      "default": "./src/*"
    },
    "./components/*": {
      "types": "./src/components/*",
      "import": "./src/components/*",
      "require": "./src/components/*",
      "default": "./src/components/*"
    },
    "./styles/flexlayout-light.css": "./src/styles/flexlayout-light.css",
    "./styles/flexlayout-dark.css": "./src/styles/flexlayout-dark.css",
    "./styles/flexlayout.css": "./src/styles/flexlayout.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run clean && tsc -b && vite build",
    "build:wc": "vite build --config vite.config.wc.ts",
    "build:types": "tsc --project tsconfig.lib.json",
    "typecheck": "tsc -b --noEmit",
    "build:lib": "bun run clean && bun run build:wc && bun run build:types",
    "prepare-package": "bun scripts/prepare-package.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "showcase": "bun run build:lib && vite --config vite.config.showcase.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepublishOnly": "bun run lint && bun test && bun run build:lib",
    "clean": "rm -rf dist dist-lib",
    "clean:source-dts": "find src -name '*.d.ts' -type f -delete"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@r2wc/react-to-web-component": "^2.0.4",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/vite": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "flexlayout-react": "^0.8.17",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.539.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-day-picker": "^9.8.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-resizable-panels": "^3.0.4",
    "recharts": "^3.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.6",
    "vaul": "^1.1.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {},
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.1.38"
}
