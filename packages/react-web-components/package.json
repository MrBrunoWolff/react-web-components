{
  "name": "@mrbrunowolff/react-web-components",
  "version": "1.1.2",
  "description": "Self-contained shadcn/ui components wrapped as Web Components for use in any framework - no external CSS dependencies required",
  "keywords": [
    "bun",
    "components",
    "design-system",
    "flexlayout",
    "react",
    "self-contained",
    "shadcn",
    "ui",
    "web-components"
  ],
  "homepage": "https://github.com/MrBrunoWolff/react-web-components#readme",
  "bugs": {
    "url": "https://github.com/MrBrunoWolff/react-web-components/issues"
  },
  "license": "MIT",
  "author": "Bruno Wolff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrBrunoWolff/react-web-components.git",
    "directory": "packages/react-web-components"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/index.*",
    "./dist/components/wc-ui/**",
    "./dist/web-components/**"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs",
      "default": "./dist/react.js"
    },
    "./wc": {
      "types": "./dist/index.d.ts",
      "import": "./dist/web-components/react-web-components.es.js",
      "require": "./dist/web-components/react-web-components.umd.cjs",
      "default": "./dist/web-components/react-web-components.es.js"
    },
    "./wc/peer": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./components/*.tsx": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs",
      "default": "./dist/components/*.js"
    },
    "./components/*.ts": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs",
      "default": "./dist/components/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs",
      "default": "./dist/components/*.js"
    },
    "./src/*.tsx": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "default": "./dist/*.js"
    },
    "./src/*.ts": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "default": "./dist/*.js"
    },
    "./src/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "default": "./dist/*.js"
    },
    "./theme.css": "./dist/theme.css",
    "./styles/flexlayout-light.css": "./dist/styles/flexlayout-light.css",
    "./styles/flexlayout-dark.css": "./dist/styles/flexlayout-dark.css",
    "./styles/flexlayout.css": "./dist/styles/flexlayout.css",
    "./package.json": "./package.json",
    "./src/styles.js": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run build:lib",
    "build:wc": "vite build --config vite.config.wc.ts",
    "build:types": "tsc --project tsconfig.lib.json",
    "typecheck": "tsc -b --noEmit",
    "build:lib": "bun run clean && bun run build:react && bun run build:wc && bun run build:theme && bun run build:types && node scripts/finalize-package.mjs && bun run check:exports",
    "prepare-package": "bun run build:lib",
    "lint": "oxlint",
    "preview": "vite preview",
    "showcase": "bun run build:lib && vite --config vite.config.showcase.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "bun run lint && bun run test && bun run build:lib",
    "clean": "rm -rf dist dist-lib",
    "clean:source-dts": "find src -name '*.d.ts' -type f -delete",
    "build:react": "vite build --config vite.config.lib.ts && vite build --config vite.config.lib.ts --mode commonjs",
    "build:theme": "vite build --config vite.config.theme.ts",
    "check:exports": "node scripts/check-exports.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@r2wc/react-to-web-component": "^2.1.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "flexlayout-react": "^0.11.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.2",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.21.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.4.2"
}
