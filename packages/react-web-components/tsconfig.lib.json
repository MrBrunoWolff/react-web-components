{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "src/global.d.ts",
    "src/react.ts",
    "src/components/**/*",
    "src/lib/**/*",
    "src/hooks/**/*",
    "src/index.ts"
  ],
  "exclude": ["**/*.test.*", "**/*.spec.*", "**/*.stories.*"]
}
